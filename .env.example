# Canonical site URL (og, sitemap, robots). Production default: give-marvin.vercel.app
SITE_URL=https://givemarvin.lol

XAI_API_KEY=
AI_GATEWAY_API_KEY=

# Model slugs. Defaults: spacexai/grok-4.6 on the gateway, grok-4.6 direct.
# A wrong slug is a 404 that falls back to the canned lines — check it with
# POST /api/state {"previewTweet":true}.
AI_GATEWAY_MODEL=
XAI_MODEL=

# Vercel Blob (auto on Vercel if a Blob store is connected)
BLOB_READ_WRITE_TOKEN=
BLOB_STORE_ID=

# Cron
CRON_SECRET=

# X API — @MajorBaguette OAuth 1.0a
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
X_BEARER_TOKEN=
